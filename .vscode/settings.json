{
  "typescript.preferences.importModuleSpecifier": "project-relative",
  "typescript.preferences.quoteStyle": "single",
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "eslint.validate": ["json"],
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "jest.virtualFolders": [
    {
      "name": "logform",
      "rootPath": "packages/logform",
      "jestCommandLine": "nx run logform:test"
    },
    {
      "name": "nx-nest",
      "rootPath": "packages/nx-nest",
      "jestCommandLine": "nx run nx-nest:test --forceExit"
    },
    {
      "name": "mailer",
      "rootPath": "packages/mailer",
      "jestCommandLine": "nx run mailer:test"
    }
  ],
  "jest.runMode": {
    "type": "on-save",
    "testFileOnly": true,
    "runAllTestsOnStartup": true
  },
  "jest.outputConfig": {
    "revealOn": "run",
    "revealWithFocus": "none",
    "clearOnRun": "none"
  },
  "debug.javascript.defaultRuntimeExecutable": {
    "pwa-node": "/home/dario/.local/share/mise/shims/node"
  }
}
